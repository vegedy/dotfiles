#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${HOME}/Pictures/wallpapers"
WAL_DIR="${HOME}/.cache/wal"
DWM_SCRIPT="${HOME}/.build/dwm/scripts/generate-dwm-xresources.sh"

if [[ $# -eq 0 ]]; then
    selected=$(
        find "$WALLPAPER_DIR" -maxdepth 1 -type f -printf '%f\n' |
            sort |
            dmenu -l 10 -p "Select wallpaper:"
    )

    [[ -z "$selected" ]] && exit 0
    wallpaper="${WALLPAPER_DIR}/${selected}"
else
    wallpaper="$1"
fi

[[ -f "$wallpaper" ]] || {
    notify-send "Wallpaper" "Nicht gefunden: $wallpaper"
    exit 1
}

wal -i "$wallpaper"

"$DWM_SCRIPT"

xrdb -merge "${WAL_DIR}/colors.Xresources"
xrdb -merge "${WAL_DIR}/dwm.Xresources"

# Signal dwm to update xrdb
xsetroot -name "fsignal:1"

