#!/usr/bin/env bash
set -euo pipefail

LOCAL_ROOT="$HOME/workspace"
WIN_HOST="bzenz@192.168.178.51"
WIN_ROOT="/cygdrive/c/Workspace"

usage() {
  echo "Usage: ws-download [--skip <ordner>]... <relativer-pfad-im-workspace>"
  echo "Beispiel: ws-download Python/MeinProjekt --skip .venv --skip node_modules"
  echo "--skip schließt Ordner aus und kann mehrfach angegeben werden."
}

EXCLUDES=()
REL_PATH=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        echo "Fehler: --skip benötigt einen Ordner." >&2
        exit 1
      fi
      EXCLUDES+=("--exclude=${2%/}/")
      shift 2
      ;;
    --skip=*)
      SKIP="${1#--skip=}"
      if [[ -z "$SKIP" ]]; then
        echo "Fehler: --skip benötigt einen Ordner." >&2
        exit 1
      fi
      EXCLUDES+=("--exclude=${SKIP%/}/")
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      if [[ $# -ne 1 || -n "$REL_PATH" ]]; then
        usage >&2
        exit 1
      fi
      REL_PATH="$1"
      shift
      ;;
    -*)
      echo "Unbekannter Parameter: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$REL_PATH" ]]; then
        echo "Fehler: Bitte genau einen Workspace-Pfad angeben." >&2
        exit 1
      fi
      REL_PATH="$1"
      shift
      ;;
  esac
done

if [[ -z "$REL_PATH" ]]; then
  usage >&2
  exit 1
fi

REL_PATH="${REL_PATH#/}"
LOCAL_PATH="$LOCAL_ROOT/$REL_PATH"
REMOTE_PATH="$WIN_ROOT/$REL_PATH"

mkdir -p "$(dirname "$LOCAL_PATH")"

rsync -avz --delete --progress \
  "${EXCLUDES[@]}" \
  "$WIN_HOST:$REMOTE_PATH" \
  "$LOCAL_PATH"
